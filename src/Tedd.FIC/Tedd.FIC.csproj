<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Tedd.FIC</RootNamespace>
    <PackageId>Tedd.FIC</PackageId>
    <Version>0.1.0</Version>
    <Authors>Tedd Hansen</Authors>
    <Description>Highly optimized, high-performance lossless RGB and RGBA image format. On a 5,000-image benchmark, FIC Fast used 53x less aggregate encode time and produced 24.6% smaller files than SkiaSharp PNG. In 512x512 synthetic tests, FIC Fast encoded and decoded faster than PNG, often in 0-2 ms. Results vary by image, settings, and hardware. Supports Deflate, GZip, Zstandard, Brotli, and EXIF metadata.</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/tedd/Tedd.FIC</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tedd/Tedd.FIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>image;compression;lossless;rgb;rgba;exif</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" Condition="'$(TargetFramework)' == 'net10.0'" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
